{
    "manifest_version": 3,
    "name": "DSA Journal",
    "version": "1.0.0",
    "description": "Local-first DSA problem tracker focused on learning reflection",
    "permissions": ["storage"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }